# Public base URL of the site (used for canonical/OG URLs and sitemap).
NEXT_PUBLIC_SITE_URL=https://kanzlei-goeren.de

# Where contact-form leads are delivered. Configure BOTH before going live.
# SMTP is used by src/app/api/lead/route.ts to send the notification e-mail.
LEAD_NOTIFY_TO=kanzlei@example.de
LEAD_NOTIFY_FROM=website@example.de
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
